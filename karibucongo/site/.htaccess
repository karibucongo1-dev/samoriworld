# Security rules (copied from samori.net, 26 Sep 2026)
Options -Indexes
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=604800"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' https://tracker.metricool.com https://tpembd.com https://emrld.ltd https://www.travelpayouts.com https://cdn.tailwindcss.com https://static.localrent.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://emrld.ltd; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://tracker.metricool.com https://tpembd.com https://emrld.ltd https://www.travelpayouts.com https://sentry.avs.io https://avsplow.com https://tpo.gg https://widget.localrent.com; frame-src 'self' https://tpembd.com https://www.travelpayouts.com; object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
</IfModule>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_METHOD} !^(GET|HEAD)$
  RewriteRule .* - [R=405,L]
</IfModule>

# Original karibucongo.com rules
RewriteEngine On
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.karibucongo.com%{REQUEST_URI} [L,R=301]

<IfModule LiteSpeed>
RewriteEngine On
RewriteRule .* - [E=Cache-Control:no-cache]
</IfModule>

<FilesMatch "index\.html$">
Header set Cache-Control "no-cache, no-store, must-revalidate"
Header set Pragma "no-cache"
Header set Expires 0
</FilesMatch>
