# Disable directory listings (audit follow-up)
Options -Indexes

# Security headers (added 2026-09-25)
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=604800"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://tracker.metricool.com https://tpembd.com https://emrld.ltd https://www.travelpayouts.com https://cdn.tailwindcss.com https://static.localrent.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://emrld.ltd; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://tracker.metricool.com https://tpembd.com https://emrld.ltd https://www.travelpayouts.com https://sentry.avs.io https://avsplow.com https://tpo.gg https://widget.localrent.com; frame-src 'self' https://tpembd.com https://www.travelpayouts.com; object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
</IfModule>

# Static site: allow only GET and HEAD (audit finding 3)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_METHOD} !^(GET|HEAD)$
  RewriteRule .* - [R=405,L]

  # Canonical host: https://www.samori.net (added 2026-10-19).
  # Scoped to samori.net hostnames only, so karibucongo.com (separate addon-domain
  # root) is never redirected even if it ever inherits this file. Path and query
  # string are kept. Validate on the live server before relying on it.
  RewriteCond %{HTTP_HOST} ^samori\.net$ [NC]
  RewriteRule ^ https://www.samori.net%{REQUEST_URI} [R=301,L]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP_HOST} ^www\.samori\.net$ [NC]
  RewriteRule ^ https://www.samori.net%{REQUEST_URI} [R=301,L]
</IfModule>

# Long cache for Next.js build assets: their file names change with every build.
# HTML keeps the no-store rule below; consent.js and images are not covered here.
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>

<IfModule LiteSpeed>
RewriteEngine On
RewriteRule .* - [E=Cache-Control:no-cache]
</IfModule>

<FilesMatch "index\.html$">
Header set Cache-Control "no-cache, no-store, must-revalidate"
Header set Pragma "no-cache"
Header set Expires 0
</FilesMatch>

<IfModule LiteSpeed>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} ^/car-rental [NC]
    RewriteRule .* - [E=Cache-Control:no-cache]
</IfModule>
