# This template is shared by samori.net and karibucongo.com.
# Set this to the site actually being built before running `npm run build` —
# it drives every canonical URL and the sitemap. Never hardcode a domain in a page file.
NEXT_PUBLIC_SITE_URL=https://www.samori.net
# For the karibucongo.com build: NEXT_PUBLIC_SITE_URL=https://www.karibucongo.com
